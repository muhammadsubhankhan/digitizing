# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real keys.
# The same variables must also be set in the Vercel project settings.
# ---------------------------------------------------------------------------

# Public site URL — no trailing slash.
# Used for canonical tags, sitemap.xml, robots.txt, Open Graph and JSON-LD.
# Must be the live domain exactly as Google should index it (www vs non-www matters).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Resend API key for the quote confirmation email (app/api/send-confirmation).
# Get it from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address for confirmation emails.
# Must be on a domain you have verified in Resend.
RESEND_FROM_EMAIL=orders@example.com
