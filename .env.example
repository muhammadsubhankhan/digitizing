# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real keys.
# The same variables must also be set in the Vercel project settings.
# ---------------------------------------------------------------------------

# Public site URL — no trailing slash.
# Used for canonical tags, sitemap.xml, robots.txt, Open Graph and JSON-LD.
# Must be the live domain exactly as Google should index it (www vs non-www matters).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Google Analytics 4 measurement ID. Optional — the live property ID is the
# default in lib/site.ts. Set this only to point a deploy at a different property.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend API key for the quote confirmation email (app/api/send-confirmation).
# Get it from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address for confirmation emails.
# Must be on a domain you have verified in Resend.
RESEND_FROM_EMAIL=orders@example.com

# --- Blog ---

# MongoDB connection string for blog posts.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=custompatchhouse

# Admin login for /admin. Change these before going live.
ADMIN_EMAIL=you@custompatchhouse.com
ADMIN_PASSWORD=choose-a-long-random-password

# Secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Where uploaded blog images are written, and the URL they are served from.
# The defaults below work with `next start`. If you redeploy by cloning into a
# fresh directory, point UPLOAD_DIR outside the repo (e.g. /var/www/uploads)
# and serve that path with nginx so uploads survive deploys.
# UPLOAD_DIR=/var/www/uploads
# PUBLIC_UPLOAD_PATH=/uploads
